page {
  background: #f4f8f4;
  color: #2d3a34;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 36rpx rgba(92, 125, 110, 0.08);
}

.top-nav__brand {
  display: flex;
  flex-direction: column;
}

.top-nav__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #234032;
}

.top-nav__subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #73877b;
}

.top-nav__links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  width: 100%;
  gap: 16rpx;
}

.nav-chip {
  min-width: 120rpx;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  background: #ecf4ee;
  color: #5b7366;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
  transition: transform 0.2s ease, background 0.2s ease;
}

.nav-chip:active {
  transform: scale(0.97);
}

.nav-chip--active {
  background: linear-gradient(135deg, #7cb38f, #9fcba8);
  color: #ffffff;
}

.card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 44rpx rgba(82, 119, 99, 0.08);
}

.panel-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #244033;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7b8d83;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1;
  transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
}

.primary-btn:active,
.secondary-btn:active,
.danger-btn:active,
.ghost-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.primary-btn {
  background: linear-gradient(135deg, #79b28c, #8fc49b);
  color: #ffffff;
}

.secondary-btn {
  background: #edf6ef;
  color: #325543;
}

.ghost-btn {
  background: transparent;
  border: 2rpx solid #d9e8dc;
  color: #557264;
}

.danger-btn {
  background: #fff2f1;
  color: #c26d67;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef6ef;
  color: #5e7868;
  font-size: 22rpx;
  line-height: 1;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #5b7064;
}

.field-block {
  width: 100%;
}

.text-input,
.text-area,
.picker-field {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f5f8f5;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2d3a34;
}

.picker-field {
  display: flex;
  align-items: center;
}

.text-area {
  min-height: 220rpx;
}

.empty-state {
  padding: 42rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8f7;
  color: #8a9991;
  font-size: 24rpx;
  text-align: center;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.list-row + .list-row {
  margin-top: 20rpx;
}

.list-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c4134;
}

.list-desc {
  font-size: 22rpx;
  color: #829187;
}

.mini-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-btn {
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1;
  background: #f1f6f2;
  color: #496253;
}

.mini-btn--danger {
  background: #fff0ef;
  color: #c46b67;
}

.bar-track {
  width: 100%;
  height: 20rpx;
  border-radius: 999rpx;
  background: #e6efea;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #79b28c, #a1cfaa);
}

.page-fade {
  animation: pageFadeIn 0.45s ease both;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
